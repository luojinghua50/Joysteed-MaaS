# Copy to .env before deployment and replace every credential.
POSTGRES_DB=maas
POSTGRES_USER=maas
POSTGRES_PASSWORD=replace-with-a-random-database-password
BIFROST_CONFIG_PASSWORD=replace-with-a-random-config-database-password
BIFROST_LOGS_PASSWORD=replace-with-a-random-logs-database-password
BIFROST_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
BIFROST_SETUP_TOKEN=replace-with-a-strong-bifrost-setup-token

MAAS_ADMIN_USERNAME=admin
MAAS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
MAAS_KEY_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MAAS_INTERNAL_TOKEN=replace-with-a-random-internal-service-token
MAAS_CONFIG_RECONCILE_INTERVAL=15s
MAAS_KV_REDIS_ADDR=redis:6379
MAAS_KV_REDIS_OP_TIMEOUT=2s
MAAS_KV_REDIS_KEY_PREFIX=bifrost:kv:
MAAS_USAGE_ENFORCEMENT=true
MAAS_CONCURRENCY_LEASE_TTL=5m
MAAS_PROVIDER_MAX_CONCURRENT=0
MAAS_BILLING_MARKUP_BPS=1000

MAAS_UI_PORT=3000
MAAS_API_PORT=18080
MAAS_GATEWAY_PORT=18081
MAAS_BIND_HOST=127.0.0.1
MAAS_CORS_ORIGIN=http://localhost:3000

# Optional comma-separated local baseline. Use an external moderation service
# for production content policy.
MAAS_GUARDRAIL_BLOCKED_TERMS=

# Set these only when the default module proxy is unavailable.
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=off
